{
  "_applies_to": "gobye-staging-private-uploads (browser PUT) and gobye-staging-public-media (GET)",
  "_note": "Staging hosts only; add a Vercel preview domain explicitly if needed, never '*'.",
  "rules": [
    {
      "AllowedOrigins": [
        "https://staging.gobye.app",
        "https://admin.staging.gobye.app",
        "http://localhost:5173",
        "http://localhost:8081"
      ],
      "AllowedMethods": [
        "PUT"
      ],
      "AllowedHeaders": [
        "content-type",
        "content-length",
        "x-amz-checksum-sha256",
        "x-amz-content-sha256",
        "x-amz-date"
      ],
      "ExposeHeaders": [
        "etag"
      ],
      "MaxAgeSeconds": 3600
    },
    {
      "AllowedOrigins": [
        "https://staging.gobye.app",
        "https://admin.staging.gobye.app",
        "http://localhost:5173",
        "http://localhost:8081"
      ],
      "AllowedMethods": [
        "GET",
        "HEAD"
      ],
      "AllowedHeaders": [
        "range",
        "if-none-match"
      ],
      "ExposeHeaders": [
        "etag",
        "content-length",
        "content-type"
      ],
      "MaxAgeSeconds": 3600
    }
  ]
}
