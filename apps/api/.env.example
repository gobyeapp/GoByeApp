# GoBye API: names only. Real values go in the server's secret store, never in git (D-051).
# Everything below "Connections" is optional and OFF by default: a feature without its key answers
# "not connected" instead of pretending.

APP_ENV=development
DATABASE_URL=
DATABASE_MIGRATION_URL=
SUPABASE_URL=
ORIGIN_AUTH_SECRET=

# --- Rides (D-100) ---
RIDE_CASH_ENABLED=false
DRIVER_PASS_REQUIRED=false

# --- Money (D-101, docs/PAYMENTS_GO_LIVE.md) ---
WALLET_ENABLED=false
PAYMENTS_PROVIDER=none            # none | simulated | paystack
PAYSTACK_SECRET_KEY=
PAYMENTS_RETURN_URL=

# --- Connections (D-103) ---
MAPS_PROVIDER=none                # none | fake | google
GOOGLE_MAPS_SERVER_KEY=
NOTIFICATIONS_PROVIDER=none       # none | log (fallback for channels without a provider)
PUSH_PROVIDER=none                # none | expo
EXPO_ACCESS_TOKEN=
EMAIL_PROVIDER=none               # none | resend
RESEND_API_KEY=
EMAIL_FROM=
SMS_PROVIDER=none                 # none | termii
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=
SUPABASE_SMS_HOOK_SECRET=
IDENTITY_PROVIDER=none            # none | simulated | qoreid
QOREID_CLIENT_ID=
QOREID_SECRET=
