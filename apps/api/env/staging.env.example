# GoBye API: STAGING template. Set these as StackShift project variables (encrypted at rest) for the
# staging environment ONLY. Separate Supabase project, separate secrets, separate R2 buckets from production.
APP_ENV=staging
# Set by the deploy pipeline to the git SHA being deployed.
APP_VERSION=
PORT=8080
LOG_LEVEL=info
# Cloudflare gateway + StackShift's own proxy.
TRUST_PROXY_HOPS=2
BODY_LIMIT_BYTES=262144

# Supabase STAGING project (docs/STAGING_SUPABASE.md). Never the website/waitlist project.
# Runtime: Supavisor TRANSACTION mode, port 6543, user gobye_api.<project-ref> (role from apps/api/db/roles.sql):
#   postgresql://gobye_api.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# The API sends no session settings at connection start (C-1); timeouts come from the role.
# Migrations: SESSION mode (port 5432 on the pooler) or the direct host, user gobye_migrator; 6543 is refused.
DATABASE_URL=
DATABASE_MIGRATION_URL=
DATABASE_SSL=verify-full
# Supabase root CA (Database settings > SSL certificate), with newlines written as \n.
DATABASE_CA_CERT=
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000

# https://<ref>.supabase.co. Tokens are verified with the project's JWKS: no JWT secret, no service-role key.
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
STAFF_REQUIRE_MFA=true

# Must equal the staging gateway Worker's ORIGIN_AUTH_SECRET (wrangler secret). 32+ random characters.
ORIGIN_AUTH_REQUIRED=true
ORIGIN_AUTH_SECRET=
CORS_ORIGINS=https://admin-staging.gobye.app

# Test-mode providers only. No real money in staging.
PAYMENTS_PROVIDER=simulated
MAPS_PROVIDER=fake
NOTIFICATIONS_PROVIDER=log
STORAGE_PROVIDER=none
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PREFIX=gobye-staging

# Run the worker as its own StackShift worker service (no public ingress); keep it off in the API.
WORKER_ENABLED=false
WORKER_POLL_MS=2000
WORKER_CONCURRENCY=2
