# GoBye API: DEVELOPMENT template (laptop). Copy to apps/api/.env (git-ignored) and fill in.
# Never commit real values. docs/ENVIRONMENT_CONFIGURATION.md lists every variable.
APP_ENV=development
APP_VERSION=dev
PORT=8080
LOG_LEVEL=info

# Local Postgres (docker compose up db) or your own Supabase dev project.
DATABASE_URL=postgres://gobye:gobye_local_only@127.0.0.1:5432/gobye_dev
DATABASE_MIGRATION_URL=
DATABASE_SSL=disable

# Supabase Auth of your DEV project (JWKS is public; no secret needed).
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Only if your dev project still uses the legacy shared secret. Refused in staging and production.
SUPABASE_ALLOW_HS256=false
SUPABASE_JWT_SECRET=
# Staff MFA is optional on a laptop; always on in production.
STAFF_REQUIRE_MFA=false

# No Cloudflare gateway in front locally.
ORIGIN_AUTH_REQUIRED=false
ORIGIN_AUTH_SECRET=
CORS_ORIGINS=http://localhost:5173

# Simulated providers are fine on a laptop (labelled simulated everywhere).
PAYMENTS_PROVIDER=simulated
MAPS_PROVIDER=fake
NOTIFICATIONS_PROVIDER=log
STORAGE_PROVIDER=memory

WORKER_ENABLED=true
WORKER_POLL_MS=2000
WORKER_CONCURRENCY=2
