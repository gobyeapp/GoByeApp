# GoBye API: PRODUCTION template. Do not deploy production until the staging tests in
# docs/DEPLOYMENT_STACKSHIFT.md pass and the owner approves (Q-072). Values live only in the host's
# secret store. Production refuses simulated/fake providers, the legacy JWT secret and unverified TLS.
APP_ENV=production
APP_VERSION=
PORT=8080
LOG_LEVEL=info
TRUST_PROXY_HOPS=2
BODY_LIMIT_BYTES=262144

DATABASE_URL=
DATABASE_MIGRATION_URL=
DATABASE_SSL=verify-full
DATABASE_CA_CERT=
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000

SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
STAFF_REQUIRE_MFA=true

ORIGIN_AUTH_REQUIRED=true
ORIGIN_AUTH_SECRET=
CORS_ORIGINS=https://admin.gobye.app

# "none" until a real adapter exists and its review is done. Real money stays off (owner restriction).
PAYMENTS_PROVIDER=none
MAPS_PROVIDER=none
NOTIFICATIONS_PROVIDER=none
STORAGE_PROVIDER=none
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PREFIX=gobye-prod

WORKER_ENABLED=false
WORKER_POLL_MS=2000
WORKER_CONCURRENCY=2

# WhatsApp quick booking (D-064, docs/WHATSAPP_BOOKING.md). none | simulated | cloud_api (simulated refused here)
# Needs the owner's Meta setup first. Secrets go in the host's secret store, never here.
WHATSAPP_PROVIDER=none
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_OPEN_LINK_BASE=https://gobye.app/open
WHATSAPP_BOOKING_ENABLED=true
