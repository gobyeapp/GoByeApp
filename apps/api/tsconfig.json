{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "../..",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "types": ["node"],
    "paths": {
      "@gobye/core": ["../../packages/core/src/index.ts"],
      "@gobye/r2-sigv4": ["../../infra/cloudflare/src/r2/sigv4.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
