# Demo relay (D-049): connect this app to the driver app and the admin with shared TEST data.
# `npm run demo:relay` (repo root) writes apps/rider/.env.local for you. Or set it by hand:
#   local relay on the same Wi-Fi:  http://<your computer's LAN IP>:8787
#   Supabase (after supabase/migrations/20261022_demo_relay.sql): the project URL + anon key
EXPO_PUBLIC_DEMO_RELAY_URL=
EXPO_PUBLIC_DEMO_RELAY_KEY=
