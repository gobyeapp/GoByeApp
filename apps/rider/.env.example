# Demo relay (D-049): connect this app to the driver app and the admin with shared TEST data.
# `npm run demo:relay` (repo root) writes apps/rider/.env.local for you. Or set it by hand:
#   local relay on the same Wi-Fi:  http://<your computer's LAN IP>:8787
#   Supabase (after supabase/migrations/20261022_demo_relay.sql): the project URL + anon key
EXPO_PUBLIC_DEMO_RELAY_URL=
EXPO_PUBLIC_DEMO_RELAY_KEY=

# Public configuration (D-051, docs/ENVIRONMENT_CONFIGURATION.md). Placeholders only: never put a secret
# (R2 keys, payment secret keys, database URLs, signing secrets) in any EXPO_PUBLIC_ variable.
# development | staging | production
EXPO_PUBLIC_ENV=development
# Stable addresses (proposed hostnames, not live yet). Required to be https / wss outside development.
EXPO_PUBLIC_API_BASE_URL=https://api.staging.gobye.app/v1
EXPO_PUBLIC_REALTIME_URL=wss://realtime.staging.gobye.app/v1
EXPO_PUBLIC_MEDIA_BASE_URL=https://media.staging.gobye.app
# Simulated services. Defaults to true outside production; refused in production builds.
EXPO_PUBLIC_USE_MOCKS=true
