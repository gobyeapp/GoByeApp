# Connected demo (D-049). Copy to .env.local, or run `npm run demo:relay` at the repo root, which writes it for you.
# Local relay on this computer:
VITE_DEMO_RELAY_URL=http://localhost:8787
# Or a Supabase project with supabase/migrations/20261022_demo_relay.sql applied (TEST DATA ONLY):
# VITE_DEMO_RELAY_URL=https://YOUR-PROJECT.supabase.co
# VITE_DEMO_RELAY_KEY=your-anon-key

# Supabase Auth for the STAGING project (Phase 2; not read by the app yet, docs/STAGING_SUPABASE.md).
# Only the PUBLISHABLE key (sb_publishable_…, or the legacy anon key) belongs here. Never the secret /
# service_role key, a database URL or a JWT secret.
# VITE_SUPABASE_URL=https://<staging-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=
