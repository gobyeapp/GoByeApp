{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_ENV": "development",
        "EXPO_PUBLIC_USE_MOCKS": "true"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "demo": {
      "extends": "preview",
      "environment": "preview"
    },
    "ios-device": {
      "extends": "preview",
      "ios": {
        "simulator": false
      }
    }
  }
}
