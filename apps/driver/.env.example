# Demo relay (D-049): connect the driver app to the rider app and the admin with shared TEST data.
# `npm run demo:relay` (repo root) writes these to .env.local automatically for the local relay.
# Leave unset to run the driver app on its own, fully simulated.
EXPO_PUBLIC_DEMO_RELAY_URL=http://192.168.1.10:8787
# Only for the Supabase demo tables (supabase/migrations/20261022_demo_relay.sql): the project's anon key.
EXPO_PUBLIC_DEMO_RELAY_KEY=
